generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Важно:
// 1. Для PostgreSQL перед первой миграцией нужно включить расширения:
//    pgcrypto, citext, btree_gist.
// 2. Prisma не описывает partial indexes, exclusion constraints и pg_trgm
//    полностью декларативно. Их стоит добавить отдельными SQL-миграциями.

enum UserStatus {
  ACTIVE   @map("active")
  INVITED  @map("invited")
  BLOCKED  @map("blocked")
  ARCHIVED @map("archived")

  @@map("user_status")
}

enum PersonStatus {
  LEAD     @map("lead")
  ACTIVE   @map("active")
  PAUSED   @map("paused")
  ARCHIVED @map("archived")

  @@map("person_status")
}

enum LessonStatus {
  PLANNED   @map("planned")
  COMPLETED @map("completed")
  CANCELLED @map("cancelled")
  MISSED    @map("missed")

  @@map("lesson_status")
}

enum LessonFormat {
  ONLINE  @map("online")
  OFFLINE @map("offline")
  HYBRID  @map("hybrid")

  @@map("lesson_format")
}

enum AttendanceStatus {
  PLANNED   @map("planned")
  ATTENDED  @map("attended")
  MISSED    @map("missed")
  CANCELLED @map("cancelled")

  @@map("attendance_status")
}

enum PaymentStatus {
  PENDING            @map("pending")
  PAID               @map("paid")
  PARTIALLY_REFUNDED @map("partially_refunded")
  REFUNDED           @map("refunded")
  CANCELLED          @map("cancelled")
  FAILED             @map("failed")

  @@map("payment_status")
}

enum InvoiceStatus {
  DRAFT          @map("draft")
  ISSUED         @map("issued")
  PARTIALLY_PAID @map("partially_paid")
  PAID           @map("paid")
  VOID           @map("void")
  OVERDUE        @map("overdue")

  @@map("invoice_status")
}

enum ContactType {
  PHONE    @map("phone")
  EMAIL    @map("email")
  TELEGRAM @map("telegram")
  WHATSAPP @map("whatsapp")
  VK       @map("vk")
  OTHER    @map("other")

  @@map("contact_type")
}

model UserAccount {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String      @unique @db.Citext
  passwordHash String      @map("password_hash")
  status       UserStatus  @default(INVITED)
  lastLoginAt  DateTime?   @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  refreshTokens   RefreshToken[]
  userRoles       UserRole[]
  teacher         Teacher?
  assignedStudents Student[]       @relation("StudentAssignedManager")
  createdInvoices Invoice[]        @relation("InvoiceCreatedBy")
  receivedPayments Payment[]       @relation("PaymentReceivedBy")
  notes           Note[]
  files           File[]
  auditLogs       AuditLog[]

  @@map("user_accounts")
}

model Role {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String  @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String  @unique
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role        @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userAgent String?   @map("user_agent")
  ip        String?   @db.Inet
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Branch {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  timezone  String   @default("Asia/Yekaterinburg")
  address   String?
  phone     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  classrooms   Classroom[]
  students     Student[]
  teachers     Teacher[]
  groups       Group[]
  lessonSeries LessonSeries[]
  lessons      Lesson[]

  @@map("branches")
}

model Classroom {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  name      String
  capacity  Int?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  branch       Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  lessonSeries LessonSeries[]
  lessons      Lesson[]

  @@unique([branchId, name])
  @@map("classrooms")
}

model Person {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName  String       @map("first_name")
  lastName   String       @map("last_name")
  middleName String?      @map("middle_name")
  birthDate  DateTime?    @map("birth_date") @db.Date
  status     PersonStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt DateTime?    @map("archived_at") @db.Timestamptz(6)

  contacts PersonContact[]
  student  Student?
  teacher  Teacher?
  guardian Guardian?

  @@index([lastName, firstName, middleName])
  @@map("persons")
}

model PersonContact {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personId   String      @map("person_id") @db.Uuid
  type       ContactType
  value      String
  isPrimary  Boolean     @default(false) @map("is_primary")
  isVerified Boolean     @default(false) @map("is_verified")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([type, value])
  @@map("person_contacts")
}

model Student {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personId          String   @unique @map("person_id") @db.Uuid
  branchId          String?  @map("branch_id") @db.Uuid
  levelCode         String?  @map("level_code")
  goal              String?
  source            String?
  assignedManagerId String?  @map("assigned_manager_id") @db.Uuid
  startedAt         DateTime? @map("started_at") @db.Date
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  person          Person       @relation(fields: [personId], references: [id], onDelete: Restrict)
  branch          Branch?      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  assignedManager UserAccount? @relation("StudentAssignedManager", fields: [assignedManagerId], references: [id], onDelete: SetNull)

  guardians          StudentGuardian[]
  enrollments        Enrollment[]
  individualSeries   LessonSeries[]
  lessonStudents     LessonStudent[]
  invoices           Invoice[]
  payments           Payment[]
  lessonCredits      LessonCredit[]
  lessonCreditUsages LessonCreditUsage[]

  @@index([branchId])
  @@index([assignedManagerId])
  @@map("students")
}

model Teacher {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personId        String   @unique @map("person_id") @db.Uuid
  userId          String?  @unique @map("user_id") @db.Uuid
  branchId        String?  @map("branch_id") @db.Uuid
  hourlyRateCents Int?     @map("hourly_rate_cents")
  currency        String   @default("RUB") @db.Char(3)
  bio             String?
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  person Person       @relation(fields: [personId], references: [id], onDelete: Restrict)
  user   UserAccount? @relation(fields: [userId], references: [id], onDelete: SetNull)
  branch Branch?      @relation(fields: [branchId], references: [id], onDelete: Restrict)

  enrollments  Enrollment[]
  lessonSeries LessonSeries[]
  lessons      Lesson[]

  @@index([branchId, isActive])
  @@map("teachers")
}

model Guardian {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personId  String   @unique @map("person_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  person   Person            @relation(fields: [personId], references: [id], onDelete: Restrict)
  students StudentGuardian[]

  @@map("guardians")
}

model StudentGuardian {
  studentId               String  @map("student_id") @db.Uuid
  guardianId              String  @map("guardian_id") @db.Uuid
  relation                String
  isPrimary               Boolean @default(false) @map("is_primary")
  canReceiveFinanceInfo   Boolean @default(true) @map("can_receive_finance_info")
  canReceiveProgressInfo  Boolean @default(true) @map("can_receive_progress_info")

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
  @@index([guardianId])
  @@map("student_guardians")
}

model Language {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code String @unique
  name String

  courses Course[]

  @@map("languages")
}

model Course {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  languageId  String   @map("language_id") @db.Uuid
  name        String
  levelCode   String?  @map("level_code")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  language    Language     @relation(fields: [languageId], references: [id], onDelete: Restrict)
  groups      Group[]
  enrollments Enrollment[]
  pricePlans  PricePlan[]

  @@index([languageId, isActive])
  @@map("courses")
}

model Group {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId    String?      @map("branch_id") @db.Uuid
  courseId    String?      @map("course_id") @db.Uuid
  name        String
  maxStudents Int?         @map("max_students")
  status      PersonStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch       Branch?        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  course       Course?        @relation(fields: [courseId], references: [id], onDelete: Restrict)
  enrollments  Enrollment[]
  lessonSeries LessonSeries[]
  lessons      Lesson[]

  @@index([branchId, status])
  @@map("groups")
}

model Enrollment {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId        String       @map("student_id") @db.Uuid
  courseId         String?      @map("course_id") @db.Uuid
  groupId          String?      @map("group_id") @db.Uuid
  primaryTeacherId String?      @map("primary_teacher_id") @db.Uuid
  status           PersonStatus @default(ACTIVE)
  startedAt        DateTime     @default(dbgenerated("CURRENT_DATE")) @map("started_at") @db.Date
  endedAt          DateTime?    @map("ended_at") @db.Date
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  student        Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course         Course?  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  group          Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  primaryTeacher Teacher? @relation(fields: [primaryTeacherId], references: [id], onDelete: SetNull)

  @@index([studentId, status])
  @@index([primaryTeacherId, status])
  @@index([groupId, status])
  @@map("enrollments")
}

model LessonSeries {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId     String?      @map("group_id") @db.Uuid
  studentId   String?      @map("student_id") @db.Uuid
  teacherId   String       @map("teacher_id") @db.Uuid
  branchId    String?      @map("branch_id") @db.Uuid
  classroomId String?      @map("classroom_id") @db.Uuid
  format      LessonFormat @default(ONLINE)
  title       String
  rrule       String?
  startsOn    DateTime?    @map("starts_on") @db.Date
  endsOn      DateTime?    @map("ends_on") @db.Date
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  group     Group?      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student   Student?    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher   Teacher     @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  branch    Branch?     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  classroom Classroom?  @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  lessons   Lesson[]

  @@index([teacherId, isActive])
  @@map("lesson_series")
}

model Lesson {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seriesId           String?      @map("series_id") @db.Uuid
  groupId            String?      @map("group_id") @db.Uuid
  teacherId          String       @map("teacher_id") @db.Uuid
  branchId           String?      @map("branch_id") @db.Uuid
  classroomId        String?      @map("classroom_id") @db.Uuid
  startsAt           DateTime     @map("starts_at") @db.Timestamptz(6)
  endsAt             DateTime     @map("ends_at") @db.Timestamptz(6)
  format             LessonFormat @default(ONLINE)
  status             LessonStatus @default(PLANNED)
  topic              String?
  homework           String?
  teacherComment     String?      @map("teacher_comment")
  cancellationReason String?      @map("cancellation_reason")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  series       LessonSeries?       @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  group        Group?              @relation(fields: [groupId], references: [id], onDelete: SetNull)
  teacher      Teacher             @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  branch       Branch?             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  classroom    Classroom?          @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  students     LessonStudent[]
  creditUsages LessonCreditUsage[]

  @@index([startsAt, endsAt])
  @@index([teacherId, startsAt])
  @@index([groupId, startsAt])
  @@index([branchId, startsAt])
  @@map("lessons")
}

model LessonStudent {
  lessonId   String           @map("lesson_id") @db.Uuid
  studentId  String           @map("student_id") @db.Uuid
  attendance AttendanceStatus @default(PLANNED)
  result     String?
  comment    String?
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  lesson  Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@id([lessonId, studentId])
  @@index([studentId, lessonId])
  @@index([attendance])
  @@map("lesson_students")
}

model PricePlan {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  courseId     String?  @map("course_id") @db.Uuid
  lessonsCount Int?     @map("lessons_count")
  amountCents  Int      @map("amount_cents")
  currency     String   @default("RUB") @db.Char(3)
  validFrom    DateTime @default(dbgenerated("CURRENT_DATE")) @map("valid_from") @db.Date
  validTo      DateTime? @map("valid_to") @db.Date
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  course   Course?   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  invoices Invoice[]

  @@index([isActive, courseId])
  @@map("price_plans")
}

model Invoice {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId        String        @map("student_id") @db.Uuid
  pricePlanId      String?       @map("price_plan_id") @db.Uuid
  status           InvoiceStatus @default(DRAFT)
  totalAmountCents Int           @map("total_amount_cents")
  paidAmountCents  Int           @default(0) @map("paid_amount_cents")
  currency         String        @default("RUB") @db.Char(3)
  issuedAt         DateTime?     @map("issued_at") @db.Timestamptz(6)
  dueAt            DateTime?     @map("due_at") @db.Timestamptz(6)
  createdById      String?       @map("created_by") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  student       Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  pricePlan     PricePlan?   @relation(fields: [pricePlanId], references: [id], onDelete: SetNull)
  createdBy     UserAccount? @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  payments      Payment[]
  lessonCredits LessonCredit[]

  @@index([studentId, status])
  @@map("invoices")
}

model Payment {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId         String        @map("student_id") @db.Uuid
  invoiceId         String?       @map("invoice_id") @db.Uuid
  status            PaymentStatus @default(PENDING)
  amountCents       Int           @map("amount_cents")
  currency          String        @default("RUB") @db.Char(3)
  method            String?
  externalPaymentId String?       @unique @map("external_payment_id")
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz(6)
  receivedById      String?       @map("received_by") @db.Uuid
  comment           String?
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  student       Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  invoice       Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  receivedBy    UserAccount? @relation("PaymentReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  lessonCredits LessonCredit[]

  @@index([studentId, createdAt])
  @@map("payments")
}

model LessonCredit {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId         String   @map("student_id") @db.Uuid
  invoiceId         String?  @map("invoice_id") @db.Uuid
  paymentId         String?  @map("payment_id") @db.Uuid
  initialLessons    Int      @map("initial_lessons")
  remainingLessons  Int      @map("remaining_lessons")
  expiresAt         DateTime? @map("expires_at") @db.Date
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  student Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  usages  LessonCreditUsage[]

  @@map("lesson_credits")
}

model LessonCreditUsage {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonCreditId String   @map("lesson_credit_id") @db.Uuid
  lessonId       String   @map("lesson_id") @db.Uuid
  studentId      String   @map("student_id") @db.Uuid
  usedLessons    Int      @default(1) @map("used_lessons")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  lessonCredit LessonCredit @relation(fields: [lessonCreditId], references: [id], onDelete: Restrict)
  lesson       Lesson       @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([lessonId, studentId])
  @@index([lessonCreditId])
  @@map("lesson_credit_usages")
}

model Note {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  authorId   String?  @map("author_id") @db.Uuid
  body       String
  isPinned   Boolean  @default(false) @map("is_pinned")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  author UserAccount? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@map("notes")
}

model File {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  uploadedBy String?  @map("uploaded_by") @db.Uuid
  storageKey String   @unique @map("storage_key")
  filename   String
  mimeType   String   @map("mime_type")
  sizeBytes  BigInt   @map("size_bytes")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  uploader UserAccount? @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@map("files")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id") @db.Uuid
  beforeData  Json?    @map("before_data")
  afterData   Json?    @map("after_data")
  ip          String?  @db.Inet
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor UserAccount? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_log")
}
